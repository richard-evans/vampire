#===================================================
# Material file for kB Monte Carlo acceptance test
#
# A single spin in an applied field with no exchange
# or anisotropy. The only energy scale is the Zeeman
# energy muB * H ~ 9.27e-24 J. The temperature
# T = 0.6717 K is chosen so that kB*T ~ muB*H,
# placing the Boltzmann acceptance probability
# exp(-dE*muB/(kB*T)) near exp(-1) ~ 0.37 for a
# typical trial move -- the point of maximum
# sensitivity to the value of kB.
#
# Initial spin direction is random so that MC moves
# in all directions are explored from the first step.
#===================================================

material:num-materials=1

material[1]:material-name=Co
material[1]:damping-constant=1.0
material[1]:exchange-matrix[1]=0.0
material[1]:atomic-spin-moment=1.0 !muB
material[1]:uniaxial-anisotropy-constant=0.0
material[1]:material-element=Co
material[1]:minimum-height=0.0
material[1]:maximum-height=1.0
material[1]:initial-spin-direction=random
