#===================================================
# Material file for Monte Carlo equilibration test
#
# Ferromagnetic exchange (positive J) drives all spins
# to align in the ground state. Anisotropy is set to
# zero so the ground state is degenerate in direction,
# but the magnetisation length is still exactly 1.
#
# Spins are initialised randomly (initial-spin-direction=random)
# to ensure the Monte Carlo integrator is genuinely
# tested by having to find the ordered ground state,
# rather than simply preserving an already-ordered state.
#===================================================

material:num-materials=1

material[1]:material-name=Co
material[1]:damping-constant=1.0
material[1]:exchange-matrix[1]=1.0e-21
material[1]:atomic-spin-moment=1.72 !muB
material[1]:uniaxial-anisotropy-constant=0.0
material[1]:material-element=Co
material[1]:minimum-height=0.0
material[1]:maximum-height=1.0
material[1]:initial-spin-direction=random
