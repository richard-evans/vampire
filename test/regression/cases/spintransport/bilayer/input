create:crystal-structure=sc
create:periodic-boundaries-x
create:periodic-boundaries-y
dimensions:unit-cell-size = 2.87 !A
dimensions:system-size-x = 2.0 !nm
dimensions:system-size-y = 2.0 !nm
dimensions:system-size-z = 2.0 !nm
material:file=Fe.mat
sim:program=time-series
sim:integrator=llg-heun
sim:temperature=0.0
sim:equilibration-time-steps=0
sim:time-steps-increment=50
sim:total-time-steps=500
sim:time-step=1.0E-16
sim:integrator-random-seed=12345
output:precision=16
output:time-steps
output:magnetisation
output:material-magnetisation
spin-transport:cell-size=1.0 !nm
spin-transport:current-direction=+z
spin-transport:applied-voltage=0.1
output:resistance
output:current
output:magneto-resistance
