create:crystal-structure=sc
create:periodic-boundaries-x
create:periodic-boundaries-y
create:periodic-boundaries-z
dimensions:unit-cell-size = 2.87 !A
dimensions:system-size-x = 2.0 !nm
dimensions:system-size-y = 2.0 !nm
dimensions:system-size-z = 2.0 !nm
material:file=Fe.mat
sim:time-step=1.0E-16
sim:integrator-random-seed=12345
output:precision=16
sim:program=hamr-simulation
sim:integrator=llg-heun
sim:equilibration-temperature=300.0
sim:minimum-temperature=300.0
sim:maximum-temperature=900.0
sim:applied-field-strength=1.0 !T
sim:applied-field-unit-vector=0,0,-1
sim:equilibration-time-steps=20
sim:time-steps-increment=50
hamr:laser-FWHM-x=1.0 !nm
hamr:laser-FWHM-y=1.0 !nm
hamr:head-field-x=1.0 !nm
hamr:head-field-y=1.0 !nm
hamr:head-speed=1.0e15
hamr:bit-sequence-type=single-tone-predefined
sim:time-step=1.0 !fs
output:output-rate=200
hamr:field-rise-time=5 !fs
hamr:field-fall-time=5 !fs
hamr:number-of-bits=2
hamr:bit-size=2.0 !nm
hamr:track-padding=0.0 !nm
dimensions:system-size-x = 4.0 !nm
dimensions:system-size-y = 4.0 !nm
dimensions:system-size-z = 1.0 !nm
hamr:track-size=2.0 !nm
hamr:NFT-to-pole-spacing=0.0 !nm
output:time-steps
output:temperature
output:applied-field-strength
output:magnetisation
output:mean-magnetisation-length
output:total-energy
