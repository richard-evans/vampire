#===================================================
# Material file for the neel-second-order anisotropy energy test
#===================================================

material:num-materials=1

material[1]:material-name=Fe
material[1]:damping-constant=1.0
material[1]:exchange-matrix[1]=1.0e-21
material[1]:atomic-spin-moment=2.2 !muB
material[1]:neel-anisotropy-constant[1]=1.0e-21
material[1]:initial-spin-direction=1,0,0
