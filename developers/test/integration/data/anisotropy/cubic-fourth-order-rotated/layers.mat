#------------------------------------------------------------------------------
# cubic-fourth-order-rotated anisotropy: five non-interacting layers of 100 atoms with spins
# along different directions; the energy of each layer is checked against
#    E = -K/2 sum_i (S.e_i)^4, e1 = [110], e2 = [-110], e3 = e1 x e2
#------------------------------------------------------------------------------
material:num-materials=5
material[1]:material-name=layer1
material[1]:damping-constant=1.0
material[1]:exchange-matrix[1]=0.0
material[1]:exchange-matrix[2]=0.0
material[1]:exchange-matrix[3]=0.0
material[1]:exchange-matrix[4]=0.0
material[1]:exchange-matrix[5]=0.0
material[1]:atomic-spin-moment=2.0 !muB
material[1]:fourth-order-cubic-anisotropy-constant=1.0e-23
material[1]:cubic-anisotropy-direction-1=1,1,0
material[1]:cubic-anisotropy-direction-2=-1,1,0
material[1]:minimum-height=0.0
material[1]:maximum-height=0.2
material[1]:initial-spin-direction=0.0000000000000000,0.0000000000000000,1.0000000000000000
