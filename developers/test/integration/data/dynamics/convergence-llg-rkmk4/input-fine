#------------------------------------------------------------------------------
# Single spin (alpha = 0.1) precessing in 1 T along z from x, to t = 20 ps
# with time step 5.0E-14 s, for the convergence order test of llg-rkmk4
#------------------------------------------------------------------------------
create:single-spin
material:file=Co.mat
sim:temperature=0.0
sim:time-steps-increment = 400
sim:total-time-steps = 400
sim:time-step=5.0E-14
sim:applied-field-strength = 1.0 !T
sim:program=benchmark
sim:integrator=llg-rkmk4
output:precision=16
output:real-time
output:magnetisation
