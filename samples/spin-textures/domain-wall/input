#----------------------------------------------------------
# Sample vampire input file demonstrating the
# material:initial-spin-direction = domain-wall-x texture
#
# A thin film is initialised with a 180 degree domain wall
# centred at x = 0.5 of the system size, with a width of
# 0.2 of the system size. Spins point along +z for x < centre
# and along -z for x > centre, with a tanh profile in between.
#----------------------------------------------------------

#----------------------------------------------------------
# Creation attributes
#----------------------------------------------------------
create:crystal-structure = fcc

#----------------------------------------------------------
# System Dimensions
#----------------------------------------------------------
dimensions:unit-cell-size = 3.524 !A
dimensions:system-size-x  = 20 !nm
dimensions:system-size-y  = 20 !nm
dimensions:system-size-z  = 1 !nm

#----------------------------------------------------------
# Material File
#----------------------------------------------------------
material:file = Co.mat

#----------------------------------------------------------
# Simulation attributes
#----------------------------------------------------------
sim:temperature              = 0.0
sim:equilibration-time-steps = 0
sim:total-time-steps          = 1
sim:time-steps-increment      = 1
sim:time-step                 = 1.0e-15

#----------------------------------------------------------
# Program and integrator
#----------------------------------------------------------
sim:program    = benchmark
sim:integrator = llg-heun

#----------------------------------------------------------
# Data output
#----------------------------------------------------------
output:real-time
output:magnetisation

screen:time-steps
screen:magnetisation

config:atoms
