#----------------------------------------------------------
# Sample vampire input file demonstrating
# material:geometry-file
#
# A bilayer film where each layer is cut to a 2D shape,
# similar to lithography: the lower layer (material 1) is
# cut to the triangle in triangle.geo and the upper layer
# (material 2) to the rectangle in rectangle.geo. The
# atomic structure is written to atoms-coords.data for
# viewing with vdc (for example vdc --povray).
#----------------------------------------------------------

#----------------------------------------------------------
# Creation attributes
#----------------------------------------------------------
create:crystal-structure = fcc
dimensions:unit-cell-size = 3.524 !A
dimensions:system-size-x  = 20 !nm
dimensions:system-size-y  = 20 !nm
dimensions:system-size-z  = 2 !nm

#----------------------------------------------------------
# Material file
#----------------------------------------------------------
material:file = bilayer.mat

#----------------------------------------------------------
# Simulation attributes
#----------------------------------------------------------
sim:temperature              = 0.0
sim:equilibration-time-steps = 0
sim:total-time-steps         = 1
sim:time-steps-increment     = 1
sim:time-step                = 1.0e-15

#----------------------------------------------------------
# Program and integrator details
#----------------------------------------------------------
sim:program    = benchmark
sim:integrator = llg-heun

#----------------------------------------------------------
# Data output
#----------------------------------------------------------
output:real-time
output:magnetisation

screen:time-steps
screen:magnetisation

config:atoms
