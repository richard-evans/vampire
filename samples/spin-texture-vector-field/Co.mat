#===================================================
# Sample vampire material file
# Cobalt thin film with an initial spin configuration
# interpolated from a user-supplied vector field
# (see input file and field.dat)
#===================================================

#---------------------------------------------------
# Number of Materials
#---------------------------------------------------
material:num-materials=1

#---------------------------------------------------
# Material 1 - Cobalt
#---------------------------------------------------
material[1]:material-name=Co
material[1]:damping-constant=1.0
material[1]:exchange-matrix[1]=11.2e-21
material[1]:atomic-spin-moment=1.72 !muB
material[1]:uniaxial-anisotropy-constant=1.0e-24
material[1]:material-element=Co

# Initial spin direction interpolated from field.dat
material[1]:initial-spin-direction = vector-field, field.dat

material[1]:minimum-height=0.0
material[1]:maximum-height=1.0
